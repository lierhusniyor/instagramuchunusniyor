# Nusxa oling: cp .env.example .env  (.env GitHub'ga YUKLANMAYDI)

# Windsor.ai (Instagram tahlil va joylash). windsor.ai > Settings > API Access
# IG_USER_ID va Meta token KERAK EMAS.
WINDSOR_API_KEY=
# Ixtiyoriy: bir nechta Instagram akkaunt bo'lsa, akkaunt ID'si
WINDSOR_IG_ACCOUNT=

# Telegram bot (@BotFather dan token, @userinfobot dan chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (ixtiyoriy): Gmail uchun "App password" kerak
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
